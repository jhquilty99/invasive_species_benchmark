# Copy this file to `.env` in this directory and fill in real values before running
# `docker compose up -d`. `.env` is gitignored — never commit real secrets.
#
# Quick generation (PowerShell):
#   openssl rand -hex 16   # SALT
#   openssl rand -hex 32   # ENCRYPTION_KEY (must be exactly 64 hex chars)
#   openssl rand -hex 32   # NEXTAUTH_SECRET
# Everything else can be any sufficiently random string.
COMPOSE_PROJECT_NAME=isb-langfuse

POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/postgres

SALT=changeme
ENCRYPTION_KEY=changeme-64-hex-chars-eg-openssl-rand-hex-32
NEXTAUTH_SECRET=changeme
NEXTAUTH_URL=http://localhost:3000

CLICKHOUSE_PASSWORD=changeme

MINIO_ROOT_PASSWORD=changeme
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=changeme
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=changeme
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=changeme

REDIS_AUTH=changeme

# Bootstraps an org/project/user on first boot so no manual signup is needed.
# Leave these blank to fall back to the normal browser signup flow instead.
LANGFUSE_INIT_ORG_ID=invasive-species-benchmark
LANGFUSE_INIT_ORG_NAME=Invasive Species Benchmark
LANGFUSE_INIT_PROJECT_ID=isb-local
LANGFUSE_INIT_PROJECT_NAME=invasive-species-benchmark (local)
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-changeme
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_NAME=Local Admin
LANGFUSE_INIT_USER_PASSWORD=changeme
