# Application/SDK-facing config, loaded by harness/config.py's pydantic-settings Settings class.
#
# This is a SEPARATE file from infra/langfuse/.env — that one is docker-compose-only, for standing
# up the self-hosted Langfuse server itself. This file is read by the Python harness at runtime.
#
# Copy to `.env` at the repo root and fill in real values. Never commit the real `.env`.

# Anthropic Console (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI Platform (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Google AI Studio / Google Cloud (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your-google-api-key-here

# Self-hosted Langfuse project settings (Project Settings > API Keys in the Langfuse UI)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here

# Self-hosted Langfuse server URL (the docker-compose stack in infra/langfuse/ started locally)
LANGFUSE_HOST=http://localhost:3000
